# Copy this file to `.env` and fill in real values from your EmailJS account
# (emailjs.com → Email Services / Email Templates / Account → API Keys).
# The public key is designed to be exposed client-side, but keep `.env` itself
# out of version control regardless — see .gitignore.
#
# Do NOT put your EmailJS Private Key here or anywhere under src/. It is
# meant for server-side use only — shipping it in client code (even via a
# VITE_ env var) exposes it to anyone who opens devtools, defeating its
# purpose of restricting who can send through your account.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Used by api/chat.ts (the AI assistant widget), a Vercel Edge Function —
# never exposed to the browser. Get a free key at
# https://aistudio.google.com/apikey (Google account, no card required for
# the free tier). Deliberately NOT prefixed with VITE_: any VITE_ variable
# gets inlined into the client bundle at build time, which would leak this
# key to anyone who opens devtools — see the warning above.
#
# Works out of the box under plain `pnpm dev` — vite.config.ts's
# localApiPlugin runs api/*.ts through Vite's own dev server, so no Vercel
# CLI is needed locally. In production, set this in Vercel's dashboard:
# Project → Settings → Environment Variables, then redeploy.
GEMINI_API_KEY=

# Used by api/github.ts (the "Repositorios" modal), a Vercel Edge Function —
# never exposed to the browser. Without this, the GitHub API is called
# unauthenticated at 60 requests/hour shared across every visitor's IP,
# which is trivially exhausted; a token raises that to 5,000/hour and is
# required for this feature to work at all.
#
# Create a classic token at https://github.com/settings/tokens (Generate
# new token → classic). No scopes need to be checked — this only ever reads
# public data, and an unscoped token still gets the higher rate limit.
# Same local-dev support as GEMINI_API_KEY above — works under plain
# `pnpm dev` once this is set in `.env`.
GITHUB_TOKEN=

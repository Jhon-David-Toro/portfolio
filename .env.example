# Copy this file to `.env` and fill in real values from your EmailJS account
# (emailjs.com → Email Services / Email Templates / Account → API Keys).
# The public key is designed to be exposed client-side, but keep `.env` itself
# out of version control regardless — see .gitignore.
#
# Do NOT put your EmailJS Private Key here or anywhere under src/. It is
# meant for server-side use only — shipping it in client code (even via a
# VITE_ env var) exposes it to anyone who opens devtools, defeating its
# purpose of restricting who can send through your account.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Used by api/chat.ts (the AI assistant widget), a Vercel Edge Function —
# never exposed to the browser. Get a free key at
# https://aistudio.google.com/apikey (Google account, no card required for
# the free tier). Deliberately NOT prefixed with VITE_: any VITE_ variable
# gets inlined into the client bundle at build time, which would leak this
# key to anyone who opens devtools — see the warning above.
#
# For local testing you'd need the Vercel CLI (`vercel dev`), since plain
# `vite dev` doesn't run Edge Functions. Otherwise, set this directly in
# Vercel's dashboard: Project → Settings → Environment Variables, then
# redeploy.
GEMINI_API_KEY=

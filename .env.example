# Copy this file to `.env` and fill in real values from your EmailJS account
# (emailjs.com → Email Services / Email Templates / Account → API Keys).
# The public key is designed to be exposed client-side, but keep `.env` itself
# out of version control regardless — see .gitignore.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
